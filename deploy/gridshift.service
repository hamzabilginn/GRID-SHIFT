[Unit]
Description=Grid Shift Racing
After=network.target
[Service]
Type=simple
User=gridshift
Group=gridshift
WorkingDirectory=/opt/grid-shift
Environment=PORT=3001
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
